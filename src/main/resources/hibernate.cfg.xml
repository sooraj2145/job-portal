<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">

<hibernate-configuration>
    <session-factory>



        <property name="hibernate.hbm2ddl.auto">validate</property>

        <property name="hibernate.show_sql">true</property>
        <property name="hibernate.format_sql">true</property>
        <property name="hibernate.highlight_sql">true</property>

        <property name="hibernate.current_session_context_class">thread</property>



        <property name="hibernate.dialect">org.hibernate.dialect.MySQLDialect</property>

        <!-- Entity classes registered here as you create them -->

        <mapping class="com.jobportal.entity.Company" />
        <mapping class="com.jobportal.entity.User" />
        <mapping class="com.jobportal.entity.JobSeekerProfile" />
        <mapping class="com.jobportal.entity.Category" />
        <mapping class="com.jobportal.entity.Skill" />
        <mapping class="com.jobportal.entity.Job" />
        <mapping class="com.jobportal.entity.Application" />


    </session-factory>
</hibernate-configuration>